  "prefix_normalization_rules": [
    {
      "id": "PREF-NORM-LOW-VOLTAGE-FLAME",
      "description": "低压阻燃前缀规范化：ZR/ZRC统一为ZC，ZRA->ZA，ZRB->ZB",
      "mappings": {
        "ZR": "ZC",
        "ZRC": "ZC",
        "ZRB": "ZB",
        "ZRA": "ZA"
      },
      "source_type": "USER_CONFIRMED",
      "scope": "global"
    },
    {
      "id": "PREF-NORM-FIRE-RESIST",
      "description": "耐火及阻燃耐火前缀规范化",
      "mappings": {
        "ZRNH": "ZCN",
        "NH": "N",
        "ZN": "ZCN"
      },
      "source_type": "USER_CONFIRMED",
      "scope": "global"
    },
    {
      "id": "PREF-PRESERVE-POLICIES",
      "description": "前缀保护红线策略",
      "rules": [
        "WDZN保留，禁止自动变WDZBN",
        "WDU保留DU，禁止丢失DU",
        "WDZC与WDZB严格区分管理",
        "WDZ-BYJ与WDZB-BYJ严格区分管理",
        "裸型号禁止自动增补阻燃或耐火前缀",
        "中压ZRC默认保留，不强制规范为ZC"
      ],
      "source_type": "USER_CONFIRMED",
      "scope": "global"
    }
  ],
  "material_conflicts": [
